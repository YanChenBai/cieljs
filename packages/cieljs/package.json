{
  "name": "cieljs",
  "version": "0.0.0",
  "description": "Composable Ciel agent runtime.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check",
