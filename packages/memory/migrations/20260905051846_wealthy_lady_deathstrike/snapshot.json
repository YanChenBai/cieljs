    {
      "value": "(\"layer\" = 'global.long_term' AND \"space_id\" IS NULL) OR (\"layer\" IN ('space.long_term', 'space.daily') AND length(trim(\"space_id\")) > 0)",
      "name": "memories_layer_space_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memories"
    },
    {
      "value": "(\"layer\" = 'space.daily' AND \"date\" IS NOT NULL) OR (\"layer\" IN ('global.long_term', 'space.long_term') AND \"date\" IS NULL)",
      "name": "memories_layer_date_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memories"
    },
    {
      "value": "\"current_revision\" > 0",
      "name": "memories_revision_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memories"
    },
    {
      "value": "\"status\" IN ('active', 'archived')",
      "name": "memories_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memories"
    },
    {
      "value": "\"dimensions\" BETWEEN 1 AND 16000 AND (\"embedding\" IS NULL OR vector_dims(\"embedding\") = \"dimensions\")",
      "name": "memory_embeddings_dimensions_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memory_embeddings"
    },
    {
      "value": "(\"status\" = 'ready' AND \"embedding\" IS NOT NULL) OR (\"status\" IN ('pending', 'failed') AND \"embedding\" IS NULL)",
      "name": "memory_embeddings_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memory_embeddings"
    },
    {
      "value": "\"revision\" > 0",
      "name": "memory_revisions_revision_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memory_revisions"
    },
    {
      "value": "\"kind\" IN ('event', 'fact', 'preference', 'summary')",
      "name": "memory_revisions_kind_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memory_revisions"
    },
    {
      "value": "length(trim(\"content\")) > 0",
      "name": "memory_revisions_content_check",
      "entityType": "checks",
      "schema": "public",
      "table": "memory_revisions"
    }
